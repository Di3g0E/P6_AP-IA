# ============================================================================
# P6_AP-IA — Variables de entorno
# Copiar a .env y rellenar. NUNCA commitear .env al repo.
# ============================================================================

# --- Base de datos ---
# Si dejas DATABASE_URL vacío (o con `...`), cae a SQLite local
# en ./data/p6.db (cero setup, ideal para desarrollo y demo).
DATABASE_URL=

# === Postgres en Docker ===
#
# Importante: el host depende de DÓNDE corre tu uvicorn:
#
#   uvicorn EN TU MÁQUINA (terminal local)  →  host = localhost
#   uvicorn DENTRO de docker compose (api)  →  host = db
#
# Modo A (uvicorn local + Postgres en Docker, lo más común en dev):
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/p6
#
# Modo B (todo en docker compose, p. ej. demo o producción):
# DATABASE_URL=postgresql+psycopg://app:app@db:5432/p6
#
# Modo C — Supabase free (cloud):
# DATABASE_URL=postgresql+psycopg://postgres.xxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- Cifrado a nivel de aplicación ---
# Clave maestra Fernet del SERVIDOR (cifra las API keys de LLM y otros secretos por usuario).
# Generar una sola vez con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_FERNET_KEY=

# Passphrase del servidor para el almacén de embeddings biométricos (P5).
# En v1 es global; en v2 podría derivarse por usuario.
EMBEDDING_STORE_PASSPHRASE=change-me-please

# --- LLM por defecto (Groq compartido para usuarios sin clave propia) ---
# Crear cuenta gratuita en https://console.groq.com
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# --- Notificaciones Telegram (bot del servidor, compartido) ---
# 1. Crear bot con @BotFather en Telegram → obtener token
# 2. Cada usuario añade su chat_id en su perfil (escribe /start al bot, copia el ID)
TELEGRAM_BOT_TOKEN=

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Lista de orígenes CORS separados por coma (frontend Next.js)
CORS_ORIGINS=http://localhost:3000,https://tu-dominio.vercel.app

# --- JWT (autenticación de sesiones) ---
JWT_SECRET=change-me-please
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Biometría (umbrales del agente Security) ---
#
# Threshold de liveness recomendado SEGÚN el modelo cargado:
#   - SIN fine-tuning (solo pesos ImageNet, mode dev):       0.30 - 0.50
#   - CON fine-tuning antispoof (NUAA/CASIA/Replay-Attack): 0.85 - 0.95
#   - Para descartar liveness en pruebas:                   0.0
LIVENESS_THRESHOLD=0.50

# Ruta al checkpoint .pth con la cabeza binaria fine-tuneada del DenseNet201.
# Si el fichero existe, se cargan sus pesos; si no, se queda con ImageNet.
# Relativa a la raíz del proyecto.
LIVENESS_MODEL_PATH=models/liveness_kaggle.pth

# Coseno entre embeddings FaceNet/VGGFace2. Subir si quieres ser más estricto.
#   - Default: 0.60 (similar autor)
#   - Más estricto: 0.75
FACE_SIMILARITY_THRESHOLD=0.60

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/app.log
